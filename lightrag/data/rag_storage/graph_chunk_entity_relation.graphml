  <data key="d0">Knot K</data>
  <data key="d1">concept</data>
  <data key="d2">A loading point in the three-bar system where forces are applied.</data>
  <data key="d3">chunk-c5d7eea8f9e0a901768256832130203b</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
