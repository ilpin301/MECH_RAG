  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897131</data>
  <data key="d14"></data>
</edge>
<edge source="Distributed Line Load" target="Differential Equation dN/dx + n = 0">
  <data key="d8">1.0</data>
