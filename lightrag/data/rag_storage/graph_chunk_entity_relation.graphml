  <data key="d0">Page Number 12</data>
  <data key="d1">artifact</data>
  <data key="d2">The page number '12' located at the bottom of the page in a document on continuum mechanics, serving as a standard navigational element marking the transition into section 11.2.1.</data>
  <data key="d3">chunk-87396546f57986339f19784a816ba8db</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Rotated Coordinate Systems">
  <data key="d0">Rotated Coordinate Systems</data>
  <data key="d1">concept</data>
  <data key="d2">A system of axes used in continuum mechanics to analyze the state of stress at different angles of orientation.</data>
  <data key="d3">chunk-87396546f57986339f19784a816ba8db</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Plane Stress Condition (ESZ)">
  <data key="d0">Plane Stress Condition (ESZ)</data>
  <data key="d1">concept</data>
  <data key="d2">A fundamental assumption in thin-walled pressure vessel analysis stating that radial stresses are negligible due to a high radius-to-thickness ratio (t ≪ r).</data>
  <data key="d3">chunk-dfafff355a9da39ab811d6385cb83520</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Longitudinal Stresses (σ_x)">
  <data key="d0">Longitudinal Stresses (σ_x)</data>
  <data key="d1">concept</data>
  <data key="d2">Stresses derived through force equilibrium in the analysis of thin-walled cylindrical pressure vessels under internal pressure.</data>
  <data key="d3">chunk-dfafff355a9da39ab811d6385cb83520</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Radial Stresses">
  <data key="d0">Radial Stresses</data>
  <data key="d1">concept</data>
  <data key="d2">Stresses that are considered negligible in the plane stress condition for thin-walled vessels.&lt;SEP&gt;Stress components that are neglected under the thin-wall assumption (t ≪ r) in a plane stress state.</data>
  <data key="d3">chunk-dfafff355a9da39ab811d6385cb83520&lt;SEP&gt;chunk-a9c3492ddaae5a544709ab9626c48a75</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Radius-to-thickness Ratio ($t \ll r$)">
  <data key="d0">Radius-to-thickness Ratio ($t \ll r$)</data>
  <data key="d1">concept</data>
  <data key="d2">A geometric ratio that is high, leading to the assumption of negligible radial stresses.</data>
  <data key="d3">chunk-dfafff355a9da39ab811d6385cb83520</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="General Stress Transformation">
  <data key="d0">General Stress Transformation</data>
  <data key="d1">concept</data>
  <data key="d2">A topic from which the content transitions to specific engineering applications in pressure vessel design.</data>
  <data key="d3">chunk-dfafff355a9da39ab811d6385cb83520</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Critical Angle">
  <data key="d0">Critical Angle</data>
  <data key="d1">concept</data>
  <data key="d2">Denoted as $\varphi^{**}$, the angle at which extremal shear stresses occur, determined by setting the derivative of shear stress $\frac{d\tau_{\xi\eta}}{d\varphi}$ to zero.</data>
  <data key="d3">chunk-edcede9e6d28ea1431d1d8fe530b301d</data>
