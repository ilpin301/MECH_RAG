  <data key="d14"></data>
</edge>
<edge source="$G^*$" target="$G$">
  <data key="d8">1.0</data>
  <data key="d9">$G^*$ is calculated using the total weight $G$ in the formula $G^*= \frac{l-x}{l} G$.</data>
