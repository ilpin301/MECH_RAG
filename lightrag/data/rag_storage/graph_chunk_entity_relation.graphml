</edge>
<edge source="Infinitesimal Rod Element" target="Free-Body Diagrams">
  <data key="d8">1.0</data>
  <data key="d9">The differential element approach enables the transition from discrete free-body diagrams to continuous field equations.</data>
  <data key="d10">enables,transitions from</data>
  <data key="d11">chunk-6e2db8e0cc453f4ff50201dc37d1fa0c</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
