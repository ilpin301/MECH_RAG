  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904249</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="τ_{ξη}">
  <data key="d8">1.0</data>
  <data key="d9">The stress transformation equations determine the shear stress τ_{ξη} as a function of σ_x, σ_y, τ_{xy}, and φ.</data>
