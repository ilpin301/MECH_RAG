  <data key="d13">1784999876</data>
  <data key="d14"></data>
</edge>
<edge source="Yield Stress (σ_y)" target="Critical Shear Stress (τ_critical)">
  <data key="d8">1.0</data>
  <data key="d9">The Yield Stress (σ_y) determines the Critical Shear Stress (τ_critical) as half its value (σ_y/2).</data>
