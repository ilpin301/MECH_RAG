  <data key="d10">chunk-c97b092fc202625d8ee8acd1894cf787</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897128</data>
  <data key="d13"></data>
</edge>
<edge source="Governing ODE For Axial Displacement" target="Finite Element Formulation">
  <data key="d7">1.0</data>
  <data key="d8">The governing ODE is central to the finite element formulation for bar elements.</data>
