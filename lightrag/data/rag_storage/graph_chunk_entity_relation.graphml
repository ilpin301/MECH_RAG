</node>
<node id="Identity Matrix">
  <data key="d0">Identity Matrix</data>
  <data key="d1">concept</data>
  <data key="d2">A mathematical matrix to which the Cauchy stress tensor is proportional, scaled by σ_0, in a hydrostatic stress state.</data>
  <data key="d3">chunk-0d8ef0753f64ed72eb451c29b8108d08</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
  <data key="d6"></data>
</node>
<node id="Deviatoric Stress Decomposition">
  <data key="d0">Deviatoric Stress Decomposition</data>
  <data key="d1">method</data>
  <data key="d2">A mathematical method where the hydrostatic stress component separates from the distortional component.</data>
  <data key="d3">chunk-0d8ef0753f64ed72eb451c29b8108d08</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
