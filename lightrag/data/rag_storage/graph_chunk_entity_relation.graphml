</node>
<node id="Cutting Planes">
  <data key="d0">Cutting Planes</data>
  <data key="d1">concept</data>
  <data key="d2">Planes on which stress vectors are introduced as the starting point of the stress tensor derivation.</data>
  <data key="d3">chunk-9cabab253ce4ee75c98c51cfd7f1a27b</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
