</node>
<node id="Stress State Points">
  <data key="d0">Stress State Points</data>
  <data key="d1">concept</data>
  <data key="d2">Points representing the stress on the x-face at coordinates (sigma_x, tau_xy) and the y-face at (sigma_y, -tau_xy) on the circle.</data>
  <data key="d3">chunk-fb9e40b1a13627933f97ce043e59f768</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
