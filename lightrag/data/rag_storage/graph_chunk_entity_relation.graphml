  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="Elastizitätsmodell">
  <data key="d0">Elastizitätsmodell</data>
  <data key="d1">concept</data>
  <data key="d2">A model used in kinematic relations to describe the elastic behavior of materials.&lt;SEP&gt;Elasticity model; a key topic describing material behavior, serving as one of the foundational pillars linking material properties to the study of structural bars.&lt;SEP&gt;The third fundamental equation type in structural analysis, constituting the constitutive law (ε = σ/E) that complements equilibrium and kinematics equations.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000&lt;SEP&gt;chunk-48b0e3f83f75ba130c72c201a9b9da1d&lt;SEP&gt;chunk-677c3b37a16b17c8907603bf39babaae</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896847</data>
  <data key="d6"></data>
</node>
<node id="Zugspannung">
  <data key="d0">Zugspannung</data>
  <data key="d1">concept</data>
  <data key="d2">Positive normal stress occurring in a bar under tensile load.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784894368</data>
  <data key="d6"></data>
</node>
<node id="Druckspannung">
  <data key="d0">Druckspannung</data>
  <data key="d1">concept</data>
  <data key="d2">Negative normal stress occurring in a bar under compressive load.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784894368</data>
  <data key="d6"></data>
</node>
<node id="Spannungsspitzen">
  <data key="d0">Spannungsspitzen</data>
  <data key="d1">concept</data>
  <data key="d2">Localized peaks in the stress distribution caused by non-uniform stress distribution, such as at the end of a bar or at a notch.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784894368</data>
  <data key="d6"></data>
</node>
<node id="Kerbe">
  <data key="d0">Kerbe</data>
  <data key="d1">concept</data>
  <data key="d2">A geometric feature (notch) in a bar that causes non-uniform stress distribution and stress peaks.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784894368</data>
  <data key="d6"></data>
</node>
<node id="Verschiebung">
  <data key="d0">Verschiebung</data>
  <data key="d1">concept</data>
  <data key="d2">The location-dependent displacement of a bar element used to describe the geometry of deformation.&lt;SEP&gt;Displacement of a bar, formulated through differential equations under thermal and mechanical loads within the document's mechanical derivations.&lt;SEP&gt;The displacement of an axially loaded single bar under loading, a key mechanical property detailed in the Einzelstab section.</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000&lt;SEP&gt;chunk-e31c68f0ed98d537493847b61aa6024c&lt;SEP&gt;chunk-9fcf46285e4f22dfa1724a1fa4063d3f</data>
