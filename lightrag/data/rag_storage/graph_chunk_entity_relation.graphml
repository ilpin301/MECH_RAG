  <data key="d14"></data>
</edge>
<edge source="Shear Strain" target="Hooke's Generalized Law">
  <data key="d8">1.0</data>
  <data key="d9">Shear strain is combined with other strain components via Hooke's generalized law to establish isotropic relationships.</data>
