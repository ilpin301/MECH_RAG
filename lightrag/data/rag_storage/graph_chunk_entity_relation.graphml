</node>
<node id="Position ℓ">
  <data key="d0">Position ℓ</data>
  <data key="d1">concept</data>
  <data key="d2">The spatial location in the 1-dimensional case at which small displacements are evaluated.</data>
  <data key="d3">chunk-e4977643a568de41c3595cee58107e8d</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
