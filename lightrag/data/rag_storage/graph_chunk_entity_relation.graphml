  <data key="d8">1.0</data>
  <data key="d9">The Elastizitätsgesetz chapter covers stress-strain relationships.</data>
  <data key="d10">covers</data>
  <data key="d11">chunk-2e13c1eccdbc66212f603ee56ccf63b8</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999853</data>
  <data key="d14"></data>
</edge>
