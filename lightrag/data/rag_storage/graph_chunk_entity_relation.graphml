  <data key="d11">chunk-0658f7561c12b0a53196517bdee01443</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904205</data>
  <data key="d14"></data>
</edge>
<edge source="Invariant I₁" target="Normal Stress σ_x">
  <data key="d8">1.0</data>
