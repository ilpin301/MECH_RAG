</node>
<node id="U(x)">
  <data key="d0">U(x)</data>
  <data key="d1">concept</data>
  <data key="d2">A displacement function that changes across the differential length dx, used to define local strain within the rod element.</data>
  <data key="d3">chunk-cebf917adc3d92ce2d5e155d10154396</data>
