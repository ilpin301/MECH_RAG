  <data key="d5">1784896973</data>
  <data key="d6"></data>
</node>
<node id="External Load F">
  <data key="d0">External Load F</data>
  <data key="d1">concept</data>
  <data key="d2">A load applied externally to a structural element, discussed in relation to internal forces within Section 10.1 Spannung.&lt;SEP&gt;An external force represented by a red arrow pointing vertically downward at Joint C.&lt;SEP&gt;The external vertical load applied at node K in the three-bar system.</data>
  <data key="d3">chunk-b47064af1c6b2b2b7fb34a9c6b98111d&lt;SEP&gt;chunk-ed3c14262e18f66ed415c1b72900af48&lt;SEP&gt;chunk-76cd2fb9e592523746e131ec4c914481</data>
