  <data key="d6"></data>
</node>
<node id="First Invariant I₁">
  <data key="d0">First Invariant I₁</data>
  <data key="d1">concept</data>
  <data key="d2">A tensor invariant quantity in 2D stress analysis defined as I₁ = σ_x + σ_y.</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903821</data>
  <data key="d6"></data>
</node>
<node id="Second Invariant I₂">
  <data key="d0">Second Invariant I₂</data>
  <data key="d1">concept</data>
  <data key="d2">A tensor invariant quantity in 2D stress analysis defined as I₂ = σ_xσ_y - τ_xy².</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903821</data>
  <data key="d6"></data>
</node>
<node id="Normal Stresses σ_ξ And σ_η">
  <data key="d0">Normal Stresses σ_ξ And σ_η</data>
  <data key="d1">concept</data>
  <data key="d2">Stress components computed using trigonometric relations involving cos²φ, sin²φ, and sin 2φ during coordinate rotation.</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903821</data>
  <data key="d6"></data>
</node>
<node id="Coordinate Rotation Angle φ">
  <data key="d0">Coordinate Rotation Angle φ</data>
  <data key="d1">concept</data>
  <data key="d2">A transformation parameter used in stress transformation equations to rotate the coordinate system.</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903821</data>
  <data key="d6"></data>
</node>
<node id="Tensor Of Second Rank">
  <data key="d0">Tensor Of Second Rank</data>
  <data key="d1">concept</data>
  <data key="d2">Also known as Tensor 2. Stufe, describes the mathematical nature of the stress state whose components transform according to specific rules while the physical state remains rotation-invariant (rotationsunabhängig).</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903824</data>
  <data key="d6"></data>
</node>
<node id="Eigenvalue Problems">
  <data key="d0">Eigenvalue Problems</data>
  <data key="d1">method</data>
  <data key="d2">Mathematical procedures used to determine principal stresses from the stress tensor.</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903824</data>
