  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999733</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Three-Dimensional Strain State">
  <data key="d8">1.0</data>
  <data key="d9">The infinitesimal strain tensor is constructed to characterize the complete three-dimensional strain state.</data>
  <data key="d10">Characterizes</data>
  <data key="d11">chunk-8f7db4e56e1df22cfa2dc24d5b3992b9</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999733</data>
  <data key="d14"></data>
</edge>
