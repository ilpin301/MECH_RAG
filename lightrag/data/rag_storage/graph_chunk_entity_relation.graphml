  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904227</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Angle-Doubling Property">
  <data key="d8">1.0</data>
  <data key="d9">The angle-doubling property arises because stress transformation equations involve trigonometric functions of 2φ.</data>
  <data key="d10">arises from,caused by</data>
  <data key="d11">chunk-3cae0fdb4f5af9a553af5e5ec7a633b8</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904235</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Equilibrium Condition For Shear Forces">
  <data key="d8">1.0</data>
  <data key="d9">The stress transformation equations are derived by combining the shear stress equilibrium equation with the analogous normal stress equilibrium.</data>
  <data key="d10">derived from</data>
