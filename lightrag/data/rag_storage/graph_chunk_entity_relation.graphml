  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Cross-Section Centroids">
  <data key="d0">Cross-Section Centroids</data>
  <data key="d1">concept</data>
  <data key="d2">The geometric centers of the cross-sections of a bar, the connecting line of which defines the bar axis.</data>
  <data key="d3">chunk-b47064af1c6b2b2b7fb34a9c6b98111d</data>
