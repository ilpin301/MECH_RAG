  <data key="d13">1784897129</data>
  <data key="d14"></data>
</edge>
<edge source="Axial Displacement Field u(x)" target="Second-Order Ordinary Differential Equation EA·u''(x) = -n">
  <data key="d8">1.0</data>
  <data key="d9">The axial displacement field is the solution to this second-order ordinary differential equation.</data>
  <data key="d10">solved by</data>
  <data key="d11">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
