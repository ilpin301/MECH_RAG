  <data key="d13"></data>
</edge>
<edge source="Governing ODE For Axial Displacement" target="Distributed Axial Load">
  <data key="d7">1.0</data>
  <data key="d8">The right-hand side of the ODE contains the distributed line load n representing self-weight.</data>
