  <data key="d8">20.0</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999864</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Strain In X-direction" target="Plane Stress Compliance Matrix Formulation">
  <data key="d8">1.0</data>
  <data key="d9">The normal strain in the x-direction is one of the three coupled strain-stress relations in the plane stress compliance matrix formulation.</data>
  <data key="d10">component of</data>
  <data key="d11">chunk-90b46de3a3db50a2d58052925f2088b0</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999864</data>
  <data key="d14"></data>
</edge>
<edge source="Shear Angle Alpha" target="Engineering Shear Strain Gamma_xy">
  <data key="d8">1.0</data>
  <data key="d9">Shear angle alpha is combined with shear angle beta to define the engineering shear strain gamma_xy.</data>
  <data key="d10">combines into,component of</data>
  <data key="d11">chunk-7a2dbfa0f426be66876905754d3b98be</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999734</data>
  <data key="d14"></data>
</edge>
<edge source="Shear Angle Beta" target="Engineering Shear Strain Gamma_xy">
  <data key="d8">1.0</data>
  <data key="d9">Shear angle beta is combined with shear angle alpha to define the engineering shear strain gamma_xy.</data>
  <data key="d10">combines into,component of</data>
