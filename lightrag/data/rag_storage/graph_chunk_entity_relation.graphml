  <data key="d0">V(x,y,z)</data>
  <data key="d1">concept</data>
  <data key="d2">The scalar displacement component of the vector field in the y-direction.</data>
  <data key="d3">chunk-5f99bd9629698e210e8fd8be478fe64f</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999158</data>
  <data key="d6"></data>
</node>
<node id="W(x,y,z)">
  <data key="d0">W(x,y,z)</data>
  <data key="d1">concept</data>
  <data key="d2">The scalar displacement component of the vector field in the z-direction.</data>
  <data key="d3">chunk-5f99bd9629698e210e8fd8be478fe64f</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
