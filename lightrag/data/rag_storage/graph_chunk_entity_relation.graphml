  <data key="d6"></data>
</node>
<node id="Page 20">
  <data key="d0">Page 20</data>
  <data key="d1">data</data>
  <data key="d2">A page in the lecture material that continues with solution steps including substitution into Δl₁ = Δl₂ cos α, determination of Stabkraft S₂, vertical displacement Δl₂, and bar forces S₁,₃.</data>
  <data key="d3">chunk-c5d7eea8f9e0a901768256832130203b</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
