  <data key="d13"></data>
</edge>
<edge source="Wahre Querschnittsfläche" target="Nominal/Engineering Area">
  <data key="d7">1.0</data>
  <data key="d8">The nominal/engineering area represents the original undeformed area, contrasting directly with the true cross-sectional area.</data>
  <data key="d9">contrasting_concepts</data>
