</node>
<node id="Megapascals">
  <data key="d0">Megapascals</data>
  <data key="d1">concept</data>
  <data key="d2">A unit of pressure or stress, explicitly mentioned as being equivalent to Newtons per square millimeter.</data>
  <data key="d3">chunk-4bc48465db9a039c612fe9cd175c5ccc</data>
