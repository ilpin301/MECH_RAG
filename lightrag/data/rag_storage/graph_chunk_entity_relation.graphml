<node id="Maximum Normal Stress">
  <data key="d0">Maximum Normal Stress</data>
  <data key="d1">concept</data>
  <data key="d2">The stress factor that governs material failure according to the normal stress hypothesis.</data>
  <data key="d3">chunk-b1a498a78500a61b206c4b1205b49030</data>
