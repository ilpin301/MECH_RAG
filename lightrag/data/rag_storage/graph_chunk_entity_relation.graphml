  <data key="d13"></data>
</edge>
<edge source="Stress Transformation Equations" target="Shear Stress Transformation Equation">
  <data key="d7">1.0</data>
  <data key="d8">The shear stress transformation equation is one of the three fundamental stress transformation equations.</data>
