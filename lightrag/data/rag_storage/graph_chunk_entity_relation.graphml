  <data key="d11">Kapitel11_Spannungszustand.pdf</data>
  <data key="d12">1784904162</data>
  <data key="d13"></data>
</edge>
<edge source="Thin-Walled Cylindrical Pressure Vessel" target="Square Element">
  <data key="d7">1.0</data>
  <data key="d8">The square element is positioned on the outer surface of the thin-walled cylindrical pressure vessel, oriented parallel and perpendicular to the central axis.</data>
  <data key="d9">located on,part of</data>
  <data key="d10">chunk-887f545fd528c5ed1b7980ed83618c38</data>
  <data key="d11">Kapitel11_Spannungszustand.pdf</data>
