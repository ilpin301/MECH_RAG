</node>
<node id="Axial Stiffness EA2">
  <data key="d0">Axial Stiffness EA2</data>
  <data key="d1">concept</data>
  <data key="d2">The axial stiffness (Dehnsteifigkeit) of the vertical bar 2 in the three-bar system.</data>
  <data key="d3">chunk-76cd2fb9e592523746e131ec4c914481</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
