</node>
<node id="Single Force">
  <data key="d0">Single Force</data>
  <data key="d1">concept</data>
  <data key="d2">A point load (Einzelkraft) acting on a bar, considered alongside line forces in structural analysis</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-001</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
