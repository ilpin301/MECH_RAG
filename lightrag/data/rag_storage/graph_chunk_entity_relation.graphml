  <data key="d5">1784999227</data>
  <data key="d6"></data>
</node>
<node id="Combined Biaxial Loading">
  <data key="d0">Combined Biaxial Loading</data>
  <data key="d1">concept</data>
  <data key="d2">A type of loading for which the full constitutive matrix is constructed using the superposition principle</data>
  <data key="d3">chunk-9d473000f8b85e21224cdb4fbff1c039</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999227</data>
