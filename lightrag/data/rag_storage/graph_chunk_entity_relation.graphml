  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999869</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Stress" target="Principal Axes System">
  <data key="d8">1.0</data>
  <data key="d9">Normal stresses are evaluated within the principal axes system in continuum mechanics.</data>
  <data key="d10">context,evaluates</data>
  <data key="d11">chunk-963728870ca7c1f5d880eae3e1e47f0f</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999869</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Stress" target="Biaxial State Of Stress">
  <data key="d8">1.0</data>
  <data key="d9">A biaxial state of stress at a 45-degree rotation transforms normal stresses into a state of pure shear.</data>
  <data key="d10">evaluates,transforms</data>
