<node id="Ibf RWTH AACHEN UNIVERSITY">
  <data key="d0">Ibf RWTH AACHEN UNIVERSITY</data>
  <data key="d1">artifact</data>
  <data key="d2">Institutional branding text displayed in the lower portion of page 1 of the document.</data>
