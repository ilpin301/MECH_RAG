  <data key="d0">Longitudinal Change In Length</data>
  <data key="d1">concept</data>
  <data key="d2">Denoted as Δl, the longitudinal change in length of a prismatic bar due to thermal effects</data>
  <data key="d3">chunk-a371746d42ee15c97ccf2f983b9237ee</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
