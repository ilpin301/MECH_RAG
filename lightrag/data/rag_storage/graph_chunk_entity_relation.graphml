<node id="Constitutive Relationship">
  <data key="d0">Constitutive Relationship</data>
  <data key="d1">concept</data>
  <data key="d2">A relationship combining mechanical and thermal effects in the framework of thermoelasticity for axially loaded members, of which the thermal expansion equation forms a part</data>
