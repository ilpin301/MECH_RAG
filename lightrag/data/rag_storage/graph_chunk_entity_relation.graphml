  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Distributed Axial Load Per Unit Length n">
  <data key="d0">Distributed Axial Load Per Unit Length n</data>
  <data key="d1">concept</data>
  <data key="d2">The constant load per unit length arising from the bar's self-weight.</data>
