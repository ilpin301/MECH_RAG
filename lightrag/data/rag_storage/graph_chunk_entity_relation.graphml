</node>
<node id="Variable 'v'">
  <data key="d0">Variable 'v'</data>
  <data key="d1">concept</data>
  <data key="d2">The variable in the incomplete equation that could represent a tensor invariant, Poisson's ratio, or a transformation parameter depending on the context.</data>
  <data key="d3">chunk-cd1f71b01c1aa5c67c36a16a597748fb</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
