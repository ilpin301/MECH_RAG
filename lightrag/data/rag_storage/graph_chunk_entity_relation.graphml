<node id="Elastic Deformation Behavior">
  <data key="d0">Elastic Deformation Behavior</data>
  <data key="d1">concept</data>
  <data key="d2">The manner in which slender structural members deform under stress, a behavior connected to stress analysis through Hooke's Law</data>
  <data key="d3">chunk-cf7cfa532d0224ec6532c6354495df59</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
