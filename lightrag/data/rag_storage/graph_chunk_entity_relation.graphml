  <data key="d5">1784903997</data>
  <data key="d6"></data>
</node>
<node id="Projected Circular Area">
  <data key="d0">Projected Circular Area</data>
  <data key="d1">concept</data>
  <data key="d2">The circular area πr² of the vessel on which the internal pressure p acts to produce the resultant force&lt;SEP&gt;The circular area πr² on which the internal pressure p exerts a force p·πr².</data>
  <data key="d3">chunk-493acae899ca4eaaedf536afa97f481b&lt;SEP&gt;chunk-73adfabedf760785acfd7b799786f369</data>
