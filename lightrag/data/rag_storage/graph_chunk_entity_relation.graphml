  <data key="d11">Kapitel11_Spannungszustand.pdf</data>
  <data key="d12">1784904261</data>
  <data key="d13"></data>
</edge>
<edge source="Wall Thickness (t)" target="Maximum Shear Stress (τ_max)">
  <data key="d7">1.0</data>
