  <data key="d14"></data>
</edge>
<edge source="Von Mises Yield Criterion" target="OCR-Corrupted Equivalent Stress (von Mises) Equation (equation)">
  <data key="d9">Entity Von Mises Yield Criterion belongs to OCR-Corrupted Equivalent Stress (von Mises) Equation (equation)&lt;SEP&gt;Entity Von Mises Yield Criterion belongs to OCR-Corrupted Equivalent Stress (von Mises) Equation (equation)</data>
  <data key="d10">belongs_to,contained_in,part_of</data>
