  <data key="d14"></data>
</edge>
<edge source="Material Point P" target="Infinitesimal Separation Dx">
  <data key="d8">1.0</data>
  <data key="d9">The variable dx represents the infinitesimal separation from the material point P to a neighboring point.</data>
  <data key="d10">measures distance from</data>
  <data key="d11">chunk-39b2f0f24ccabd94f6101afe155c90b1</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999728</data>
  <data key="d14"></data>
</edge>
<edge source="Material Point Q" target="Equation $u_Q = u_P + (\partial u/\partial x)dx + (\partial u/\partial y)dy$">
  <data key="d8">1.0</data>
  <data key="d9">The equation is used to express the displacement at point Q based on the neighboring point P.</data>
  <data key="d10">expresses displacement</data>
  <data key="d11">chunk-646c9364260cc8f0c76b71d04358c907</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999716</data>
  <data key="d14"></data>
</edge>
<edge source="Material Point Q" target="Directed Line Element">
  <data key="d8">1.0</data>
  <data key="d9">The directed line element connects point P to its neighboring point Q.</data>
  <data key="d10">connects</data>
  <data key="d11">chunk-646c9364260cc8f0c76b71d04358c907</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999716</data>
  <data key="d14"></data>
</edge>
<edge source="Material Point Q" target="Differential Position Vector">
  <data key="d8">1.0</data>
  <data key="d9">The differential position vector measures the spatial difference between points P and Q.</data>
  <data key="d10">measures difference</data>
  <data key="d11">chunk-646c9364260cc8f0c76b71d04358c907</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999716</data>
  <data key="d14"></data>
</edge>
