</node>
<node id="Linear-elastic Region">
  <data key="d0">Linear-elastic Region</data>
  <data key="d1">concept</data>
  <data key="d2">The initial region of the stress-strain curve where Hooke's Law applies, represented by a straight line from the zero point.</data>
  <data key="d3">chunk-73a8a17ee36ec3a25041cb22c3b85cd5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="Plastic Deformation Region">
  <data key="d0">Plastic Deformation Region</data>
  <data key="d1">concept</data>
