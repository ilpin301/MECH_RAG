  <data key="d14"></data>
</edge>
<edge source="Rotational Angle Beta" target="Shear Strain Gamma Xy">
  <data key="d8">1.0</data>
  <data key="d9">The total shear strain γ_xy is the sum of rotational angles α and β.</data>
