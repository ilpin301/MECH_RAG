</node>
<node id="Generalized Hooke's Law For Thermoelasticity">
  <data key="d0">Generalized Hooke's Law For Thermoelasticity</data>
  <data key="d1">concept</data>
  <data key="d2">A constitutive law representing the decomposition of total strain into mechanical and thermal components for thermoelasticity in one-dimensional bar mechanics.</data>
  <data key="d3">chunk-3fb28b0e78717850205497e7c5e164dc</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="One-Dimensional Bar Mechanics">
  <data key="d0">One-Dimensional Bar Mechanics</data>
  <data key="d1">concept</data>
  <data key="d2">The specific field of mechanics where the generalized Hooke's law for thermoelasticity is applied.</data>
  <data key="d3">chunk-3fb28b0e78717850205497e7c5e164dc</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="Total Strain">
  <data key="d0">Total Strain</data>
  <data key="d1">concept</data>
  <data key="d2">The total longitudinal strain in a bar, which equals the sum of mechanical and thermal strains.</data>
  <data key="d3">chunk-3fb28b0e78717850205497e7c5e164dc</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="Classical Hooke's Law">
  <data key="d0">Classical Hooke's Law</data>
  <data key="d1">concept</data>
  <data key="d2">The traditional law relating stress and strain, used to determine mechanical strain when temperature change is zero.</data>
  <data key="d3">chunk-3fb28b0e78717850205497e7c5e164dc</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
