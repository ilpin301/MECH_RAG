  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Stress σ(x)">
  <data key="d0">Stress σ(x)</data>
  <data key="d1">concept</data>
  <data key="d2">The axial stress derived from the displacement, equal to (G/A)(1 - x/l), with maximum value at the fixed support.</data>
  <data key="d3">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Theory of Elastostatics">
  <data key="d0">Theory of Elastostatics</data>
  <data key="d1">concept</data>
  <data key="d2">A branch of mechanics dealing with the behavior of elastic solid bodies in static equilibrium.</data>
  <data key="d3">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
