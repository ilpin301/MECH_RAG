<node id="Kinematic Quantity">
  <data key="d0">Kinematic Quantity</data>
  <data key="d1">concept</data>
  <data key="d2">Also known as kinematische Größe, a classification of physical variables that describe the geometry of deformation, such as strain.</data>
  <data key="d3">chunk-85da86ad0233986cf40614b65dc61ad2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
