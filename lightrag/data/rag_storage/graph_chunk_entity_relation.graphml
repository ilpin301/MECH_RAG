  <data key="d13">1784904244</data>
  <data key="d14"></data>
</edge>
<edge source="Thin-walled Cylindrical Pressure Vessel" target="Radial Stresses">
  <data key="d8">1.0</data>
  <data key="d9">In the analysis of the thin-walled cylindrical pressure vessel, radial stresses are assumed to be negligible.</data>
  <data key="d10">assumption,negligible</data>
