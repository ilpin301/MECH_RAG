<node id="General Analytical Solution">
  <data key="d0">General Analytical Solution</data>
  <data key="d1">concept</data>
  <data key="d2">The integral form equation representing the longitudinal displacement of a one-dimensional structural member.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Longitudinal Displacement">
  <data key="d0">Longitudinal Displacement</data>
  <data key="d1">concept</data>
  <data key="d2">The spatial displacement $u(x)$ along the longitudinal axis of a structural member.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Particular Integral">
  <data key="d0">Particular Integral</data>
  <data key="d1">concept</data>
  <data key="d2">The term accounting for the body force (self-weight) in the analytical solution, represented by the $x^2$ term.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Complementary Solution">
  <data key="d0">Complementary Solution</data>
  <data key="d1">concept</data>
  <data key="d2">The homogeneous solution representing rigid body translation and uniform strain modes, consisting of constants of integration.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Internal Normal Force Equation">
  <data key="d0">Internal Normal Force Equation</data>
  <data key="d1">concept</data>
  <data key="d2">The equation derived by taking the first derivative of the general analytical solution, yielding internal normal force.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Total Weight of the Rod">
  <data key="d0">Total Weight of the Rod</data>
  <data key="d1">concept</data>
  <data key="d2">The total weight or weight force ($G$) of the rod, which defines a constant distributed line load.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Total Length of the Rod">
  <data key="d0">Total Length of the Rod</data>
  <data key="d1">concept</data>
  <data key="d2">The overall length of the structural member denoted by $l$.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Spatial Coordinate">
  <data key="d0">Spatial Coordinate</data>
  <data key="d1">concept</data>
  <data key="d2">The coordinate $x$ along the longitudinal axis of the structural member.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Constants of Integration">
  <data key="d0">Constants of Integration</data>
  <data key="d1">concept</data>
  <data key="d2">Values $C_1$ and $C_2$ determined by static boundary conditions.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Geometric Compatibility Equations">
  <data key="d0">Geometric Compatibility Equations</data>
  <data key="d1">concept</data>
  <data key="d2">Equations, such as total elongation being zero, required to solve statically indeterminate examples.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Suspension Cables">
  <data key="d0">Suspension Cables</data>
  <data key="d1">artifact</data>
  <data key="d2">Load-bearing components where axial deformation formulations are applied.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Vertical Hangers">
  <data key="d0">Vertical Hangers</data>
  <data key="d1">artifact</data>
  <data key="d2">Load-bearing components where axial deformation formulations are applied.&lt;SEP&gt;Structural elements designed based on the principles of linear stress distribution in axially loaded bars.</data>
  <data key="d3">chunk-920d899bb09d20ddc75b79ec193db2e5&lt;SEP&gt;chunk-213cdd3f8f32396583dc5a4fa4d54dfd</data>
