</node>
<node id="Strain Ε">
  <data key="d0">Strain Ε</data>
  <data key="d1">concept</data>
  <data key="d2">A kinematic quantity introduced alongside displacement to describe deformation geometry.</data>
  <data key="d3">chunk-23f9a8f34af690fb6d5cb0ea12f409a1</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
