</node>
<node id="Proportional Limit (σ_P)">
  <data key="d0">Proportional Limit (σ_P)</data>
  <data key="d1">concept</data>
  <data key="d2">A critical stress level marked on the vertical axis indicating the maximum stress where stress and strain are directly proportional.</data>
  <data key="d3">chunk-73a8a17ee36ec3a25041cb22c3b85cd5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
  <data key="d6"></data>
</node>
<node id="Yield Strength (σ_F)">
  <data key="d0">Yield Strength (σ_F)</data>
  <data key="d1">concept</data>
  <data key="d2">A critical stress level marked on the vertical axis (Fließgrenze) beyond which the material undergoes plastic deformation.</data>
  <data key="d3">chunk-73a8a17ee36ec3a25041cb22c3b85cd5</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
