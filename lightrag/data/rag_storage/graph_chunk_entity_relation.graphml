  <data key="d14"></data>
</edge>
<edge source="Axial Displacement Field u(x)" target="Strain Field ε(x)">
  <data key="d8">1.0</data>
  <data key="d9">The strain field ε(x) = du/dx is the spatial derivative of the axial displacement field with respect to position x.</data>
