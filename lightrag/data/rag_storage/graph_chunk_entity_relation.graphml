  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897131</data>
  <data key="d14"></data>
</edge>
<edge source="Concentrated Point Load" target="Self-Weight Elongation">
  <data key="d8">1.0</data>
  <data key="d9">The Self-Weight Elongation equals exactly half the elongation that would result from applying the total weight as a Concentrated Point Load at the free end.</data>
