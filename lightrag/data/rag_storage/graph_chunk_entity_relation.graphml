  <data key="d0">Infinitesimal Cubic Element</data>
  <data key="d1">concept</data>
  <data key="d2">A geometric element used in the derivation, through whose center an axis passes for calculating the moment equilibrium.</data>
  <data key="d3">chunk-bf36ff85412f3dea295a176bbfb87119</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
