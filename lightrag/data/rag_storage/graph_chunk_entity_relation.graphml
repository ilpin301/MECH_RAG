<node id="2φ*">
  <data key="d0">2φ*</data>
  <data key="d1">concept</data>
  <data key="d2">An angle denoted by a light green arc originating from center M, located between the horizontal radius toward σ1 and the radius to the point (σx, τxy), representing twice the physical rotation of the stress element.</data>
  <data key="d3">chunk-5ca440e5727deb504109d3cda9b3642d</data>
