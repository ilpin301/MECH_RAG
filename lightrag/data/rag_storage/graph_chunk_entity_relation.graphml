</node>
<node id="German Engineering Mechanics Textbook Series">
  <data key="d0">German Engineering Mechanics Textbook Series</data>
  <data key="d1">content</data>
  <data key="d2">A well-known multi-volume German engineering mechanics textbook series.</data>
  <data key="d3">chunk-2d9d584003e02eb55f646636643aaba8</data>
