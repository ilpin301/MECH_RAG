  <data key="d13"></data>
</edge>
<edge source="Hydrostatic Stress State" target="Mohr's Circle Of Stress">
  <data key="d7">1.0</data>
  <data key="d8">The hydrostatic stress state is identified as Sonderfall 3 (Special Case 3) in the context of Mohr's Circle of Stress, where the circle degenerates into a single point.</data>
  <data key="d9">related to,special case of</data>
  <data key="d10">chunk-98ff466f481e3ef48f03b583574686cc</data>
  <data key="d11">Kapitel11_Spannungszustand.pdf</data>
  <data key="d12">1784904221</data>
  <data key="d13"></data>
</edge>
<edge source="Hydrostatic Stress State" target="Sigma 0">
  <data key="d7">1.0</data>
  <data key="d8">The hydrostatic stress state occurs when the normal stresses in all directions are equal to $\\sigma_0$.</data>
  <data key="d9">characterizes,condition for</data>
  <data key="d10">chunk-98ff466f481e3ef48f03b583574686cc</data>
  <data key="d11">Kapitel11_Spannungszustand.pdf</data>
  <data key="d12">1784904222</data>
  <data key="d13"></data>
</edge>
