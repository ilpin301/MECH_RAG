  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904244</data>
  <data key="d14"></data>
</edge>
<edge source="Thin-walled Cylindrical Pressure Vessel" target="Radius-to-thickness Ratio ($t \ll r$)">
  <data key="d8">1.0</data>
  <data key="d9">The thin-walled cylindrical pressure vessel analysis assumes a high radius-to-thickness ratio where t is much less than r.</data>
  <data key="d10">assumption,geometric property</data>
