  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904249</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Trigonometric Identities">
  <data key="d8">1.0</data>
  <data key="d9">The stress transformation equations are simplified using trigonometric identities to yield the final form of the shear stress equation.</data>
  <data key="d10">simplified using</data>
  <data key="d11">chunk-20d2489764cb6b004e3ff06ba7ebe0c1</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904249</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Stress State Coordinate Transformation Diagram">
  <data key="d8">1.0</data>
