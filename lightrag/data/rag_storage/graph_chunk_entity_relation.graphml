</node>
<node id="Elastic Lengthening">
  <data key="d0">Elastic Lengthening</data>
  <data key="d1">concept</data>
  <data key="d2">The deformation or change in length of the bars under load, defined by the formula Δl = Sl/EA, which is substituted into the compatibility equation.</data>
  <data key="d3">chunk-9966746921724686a393e234327d9e41</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
