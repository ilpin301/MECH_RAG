  <data key="d11">chunk-792f1aab7b01df3f4ae8fa499208a41a</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904180</data>
  <data key="d14"></data>
</edge>
<edge source="Trigonometric Identities" target="Normal Stress Transformation Law">
  <data key="d8">1.0</data>
  <data key="d9">The subsequent derivation of explicit principal stresses from this transformation law uses trigonometric identities</data>
  <data key="d10">derived using</data>
  <data key="d11">chunk-3780797c1d45f39538f2b68c98e007f0</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904214</data>
  <data key="d14"></data>
</edge>
<edge source="Trigonometric Identities" target="Stress Components">
  <data key="d8">1.0</data>
  <data key="d9">Trigonometric identities express sin(2φ*) and cos(2φ*) as rational functions of the stress components</data>
  <data key="d10">expressed as functions of</data>
