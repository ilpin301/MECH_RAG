<node id="Materials Engineering">
  <data key="d0">Materials Engineering</data>
  <data key="d1">method</data>
  <data key="d2">A field in which coordinate transformation of stress states is applied for failure analysis of structural components.&lt;SEP&gt;An engineering discipline where the fundamental relationships between elastic moduli are applied for analyzing material behavior.</data>
  <data key="d3">chunk-68094852a469c1054fde9d0f452e6077&lt;SEP&gt;chunk-b5deab09d1c9d30fa6463bb3156b4278</data>
