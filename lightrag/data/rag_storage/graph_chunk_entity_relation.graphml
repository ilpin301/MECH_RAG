  <data key="d0">Querschnittsbemessung</data>
  <data key="d1">concept</data>
  <data key="d2">Cross-section design, a sub-topic within stress analysis discussed in the document.</data>
  <data key="d3">chunk-0e05e8f931eaf44276170a34134cf8c6</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
