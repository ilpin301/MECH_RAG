  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Sine And Cosine">
  <data key="d0">Sine And Cosine</data>
  <data key="d1">method</data>
  <data key="d2">Trigonometric functions evaluated at a compound angle in the coordinate transformation equation, with terms squared and multiplied.</data>
  <data key="d3">chunk-cf5a136f98019f0bd369d2b6d44879f8</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Yielding And Failure Of Materials">
  <data key="d0">Yielding And Failure Of Materials</data>
  <data key="d1">concept</data>
  <data key="d2">Material responses under complex, multi-axial loading conditions predicted using Mohr's Circle.</data>
  <data key="d3">chunk-cf5a136f98019f0bd369d2b6d44879f8</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
