</node>
<node id="Location-dependent Cross-sectional Areas">
  <data key="d0">Location-dependent Cross-sectional Areas</data>
  <data key="d1">concept</data>
  <data key="d2">A mechanical concept related to strain discussed in the document.</data>
  <data key="d3">chunk-6d7acbcd6b20eaf7e62181f096df8a5e</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
