  <data key="d2">An individual who proposed a specific strength hypothesis in the year 1864.</data>
  <data key="d3">chunk-b5103d6213d27573d3ccf1c58deb496d</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999485</data>
  <data key="d6"></data>
</node>
