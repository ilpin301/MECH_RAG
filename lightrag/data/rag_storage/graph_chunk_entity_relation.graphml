  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904217</data>
  <data key="d14"></data>
</edge>
<edge source="Trigonometric Identities" target="Pythagorean Identity">
  <data key="d8">1.0</data>
  <data key="d9">The Pythagorean identity sin²(2φ*) + cos²(2φ*) = 1 is the fundamental identity that validates the trigonometric expressions used in principal stress derivation.</data>
  <data key="d10">fundamental identity,self-consistency</data>
  <data key="d11">chunk-a6643a9ec6dd9b81db5b4233bf1899ef</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904233</data>
  <data key="d14"></data>
</edge>
<edge source="Trigonometric Identities" target="Sin(2φ*) Expression">
  <data key="d8">1.0</data>
  <data key="d9">The sine expression is one of the trigonometric expressions used in deriving principal stresses.</data>
