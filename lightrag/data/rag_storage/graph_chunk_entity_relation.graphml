  <data key="d0">Constitutive Equations</data>
  <data key="d1">concept</data>
  <data key="d2">Mathematical equations formulated in solid mechanics, fluid dynamics, and finite element analysis, for which the symmetric stress tensor is essential.</data>
  <data key="d3">chunk-012508b359d5f14b7a687dd269f97c12</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
  <data key="d6"></data>
</node>
<node id="Fluid Dynamics">
  <data key="d0">Fluid Dynamics</data>
  <data key="d1">concept</data>
  <data key="d2">A field of mechanics where constitutive equations rely on the symmetric stress tensor.</data>
