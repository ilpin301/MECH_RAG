  <data key="d13">1784999733</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Strain Epsilon Y" target="Material Points">
  <data key="d8">1.0</data>
  <data key="d9">Normal strain epsilon_y quantifies the relative length change between material points before and after deformation.</data>
