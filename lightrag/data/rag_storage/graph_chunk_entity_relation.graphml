  <data key="d3">doc-d4e48f780c214c48a682a8ccd2b8aa87-chunk-001</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784964350</data>
  <data key="d6"></data>
</node>
<node id="Innere Energie U">
  <data key="d0">Innere Energie U</data>
  <data key="d1">concept</data>
  <data key="d2">The internal energy of a material, decomposed into distortion energy and hydrostatic energy components</data>
