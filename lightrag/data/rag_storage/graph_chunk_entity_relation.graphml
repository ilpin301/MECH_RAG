  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Second-Order Ordinary Differential Equation" target="Axial Equilibrium">
  <data key="d8">1.0</data>
  <data key="d9">The Second-Order Ordinary Differential Equation mathematically governs the Axial Equilibrium of the rod.</data>
