<node id="Power-reduction Trigonometric Identities">
  <data key="d0">Power-reduction Trigonometric Identities</data>
  <data key="d1">method</data>
  <data key="d2">Identities used along with double-angle identities to derive the intended transformation equation's trigonometric functions.</data>
  <data key="d3">chunk-68094852a469c1054fde9d0f452e6077</data>
