  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896847</data>
  <data key="d6"></data>
</node>
<node id="Elastic Behavior">
  <data key="d0">Elastic Behavior</data>
  <data key="d1">concept</data>
  <data key="d2">Material behavior where the material takes its original length after complete unloading, occurring when stress is below the yield stress&lt;SEP&gt;Material response classification applicable when the absolute value of stress σ is less than yield stress σ_F</data>
  <data key="d3">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-001&lt;SEP&gt;chunk-89b8532cdf159a4bfe5be48dea8b78e2</data>
