  <data key="d6"></data>
</node>
<node id="Plastic Strain (ε_pl)">
  <data key="d0">Plastic Strain (ε_pl)</data>
  <data key="d1">concept</data>
  <data key="d2">The remaining permanent deformation on the horizontal axis after the load is removed.</data>
  <data key="d3">chunk-73a8a17ee36ec3a25041cb22c3b85cd5</data>
