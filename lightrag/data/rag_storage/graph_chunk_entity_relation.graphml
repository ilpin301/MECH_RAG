</node>
<node id="Statically Indeterminate Structural System">
  <data key="d0">Statically Indeterminate Structural System</data>
  <data key="d1">concept</data>
  <data key="d2">A structural system whose support reactions cannot be determined by static equilibrium alone.&lt;SEP&gt;A structural system composed of three bars analyzed for forces and displacements.</data>
  <data key="d3">chunk-cdfa6405eb28772fd593fe970821beaf&lt;SEP&gt;chunk-5e6428916bed03d77d29954942400a6f</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Small-Strain Theory">
  <data key="d0">Small-Strain Theory</data>
  <data key="d1">method</data>
  <data key="d2">A theory used to relate the horizontal and vertical components of displacement to the axial elongations of inclined members.</data>
  <data key="d3">chunk-cdfa6405eb28772fd593fe970821beaf</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Middle Bar">
  <data key="d0">Middle Bar</data>
  <data key="d1">artifact</data>
  <data key="d2">The central vertical bar whose vertical displacement and elongation are analyzed.</data>
  <data key="d3">chunk-cdfa6405eb28772fd593fe970821beaf</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Inclined Bars">
  <data key="d0">Inclined Bars</data>
  <data key="d1">artifact</data>
  <data key="d2">The outer bars arranged at an angle, whose elongations are analyzed.</data>
  <data key="d3">chunk-cdfa6405eb28772fd593fe970821beaf</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
