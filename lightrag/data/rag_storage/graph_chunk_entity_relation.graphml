  <data key="d5">1784999493</data>
  <data key="d6"></data>
</node>
<node id="Angular Orientation Of Maximum Shear Stress">
  <data key="d0">Angular Orientation Of Maximum Shear Stress</data>
  <data key="d1">concept</data>
  <data key="d2">The angle φ** at which maximum shear stress occurs, where the normal stress equals the hydrostatic stress σ_M.</data>
  <data key="d3">chunk-bcd5ad0575ad16303ca4601a26ea32f2</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
