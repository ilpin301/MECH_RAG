</node>
<node id="Arbitrary Plane">
  <data key="d0">Arbitrary Plane</data>
  <data key="d1">concept</data>
  <data key="d2">A theoretical plane within a material on which the state of stress is calculated in continuum mechanics.</data>
  <data key="d3">chunk-68094852a469c1054fde9d0f452e6077</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903990</data>
  <data key="d6"></data>
</node>
<node id="Structural Components">
  <data key="d0">Structural Components</data>
  <data key="d1">artifact</data>
  <data key="d2">Physical objects analyzed in materials engineering and structural mechanics using stress transformations for failure analysis.&lt;SEP&gt;Physical parts of a structure where deformations are calculated using engineering equations.</data>
  <data key="d3">chunk-68094852a469c1054fde9d0f452e6077&lt;SEP&gt;chunk-b73317ca6218a3794fd92d7cfec3e4db</data>
