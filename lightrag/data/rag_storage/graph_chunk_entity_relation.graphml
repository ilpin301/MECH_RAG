<node id="Unit Vector">
  <data key="d0">Unit Vector</data>
  <data key="d1">concept</data>
  <data key="d2">A vector with a norm of one, which the numerical tuples in the equation resemble components of</data>
  <data key="d3">chunk-0fca9235e4f945947ddf250020a6f05e</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
