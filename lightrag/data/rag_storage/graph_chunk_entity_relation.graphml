  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Uniformly Hanging Rod" target="Dirichlet-Type Boundary Condition">
  <data key="d8">1.0</data>
  <data key="d9">The Uniformly Hanging Rod is constrained at the fixed support by the Dirichlet-Type Boundary Condition.</data>
  <data key="d10">constrained by</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Uniformly Hanging Rod" target="Internal Normal Force">
  <data key="d8">1.0</data>
  <data key="d9">The Uniformly Hanging Rod experiences an Internal Normal Force that varies linearly along its length.</data>
  <data key="d10">experiences</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Uniformly Hanging Rod" target="Distributed Line Load">
  <data key="d8">1.0</data>
  <data key="d9">The Uniformly Hanging Rod is subjected to a constant Distributed Line Load representing its self-weight.</data>
  <data key="d10">subjected to</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
