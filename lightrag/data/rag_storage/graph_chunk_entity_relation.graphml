  <data key="d8">1.0</data>
  <data key="d9">The displacement gradient tensor is essential for deriving the infinitesimal strain tensor.</data>
  <data key="d10">computes,derives</data>
  <data key="d11">chunk-603ebcda3c395baf69674e7e06ddebff</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999718</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Side Lengths">
  <data key="d8">1.0</data>
  <data key="d9">The infinitesimal strain tensor formulates strain measures that capture changes in the side lengths of differential elements.</data>
  <data key="d10">captures changes in</data>
  <data key="d11">chunk-603ebcda3c395baf69674e7e06ddebff</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999718</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Angles">
  <data key="d8">1.0</data>
  <data key="d9">The infinitesimal strain tensor formulates strain measures that capture changes in the angles of differential elements.</data>
  <data key="d10">captures changes in</data>
  <data key="d11">chunk-603ebcda3c395baf69674e7e06ddebff</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999718</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Linearization Process">
  <data key="d8">1.0</data>
  <data key="d9">The linearization process is the foundational step used to derive the infinitesimal strain tensor.</data>
  <data key="d10">derivation</data>
  <data key="d11">chunk-2e8d2b1a89f6cabb7e72a9e7705515dc</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999724</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Equation y = x + dx">
  <data key="d8">1.0</data>
  <data key="d9">The equation is essential for deriving the infinitesimal (Cauchy) strain tensor.</data>
  <data key="d10">derives,essential for</data>
  <data key="d11">chunk-5388c9868e6383d81b0b079e7adc1c81</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999726</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Side Lengths And Angles">
  <data key="d8">1.0</data>
  <data key="d9">The infinitesimal strain tensor quantifies changes in side lengths and angles.</data>
  <data key="d10">quantifies</data>
  <data key="d11">chunk-5388c9868e6383d81b0b079e7adc1c81</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999726</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Kleine Deformationen">
  <data key="d8">1.0</data>
  <data key="d9">The infinitesimal strain tensor is formulated under the assumption of kleine Deformationen.</data>
  <data key="d10">derived from assumption</data>
  <data key="d11">chunk-73f6cf7471ec2d0c8d45890d1117b1c9</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999729</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Linearization">
  <data key="d8">1.0</data>
  <data key="d9">Linearization through truncating higher-order terms is central to the formulation of the infinitesimal strain tensor.</data>
  <data key="d10">central to</data>
  <data key="d11">chunk-73f6cf7471ec2d0c8d45890d1117b1c9</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999730</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Normal Strain">
  <data key="d8">1.0</data>
  <data key="d9">Defining the normal strain serves as a foundational step in deriving the infinitesimal strain tensor.</data>
  <data key="d10">derivation,foundation</data>
  <data key="d11">chunk-9f3dea07a2a72e1fd56bdd66b98441fc</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999732</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Geometric Linear Theory">
  <data key="d8">1.0</data>
  <data key="d9">The derivation of the infinitesimal strain tensor inherently assumes the conditions of geometric linear theory.</data>
  <data key="d10">context,theoretical assumption</data>
  <data key="d11">chunk-9f3dea07a2a72e1fd56bdd66b98441fc</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999732</data>
  <data key="d14"></data>
</edge>
<edge source="Infinitesimal Strain Tensor" target="Strain-displacement Relations">
  <data key="d8">1.0</data>
  <data key="d9">Strain-displacement relations are the kinematic equations that construct the infinitesimal strain tensor.</data>
