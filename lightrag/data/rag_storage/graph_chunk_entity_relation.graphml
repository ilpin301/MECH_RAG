  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Governing Ordinary Differential Equation (ODE)" target="Stabtragwerk Analysis">
  <data key="d7">1.0</data>
  <data key="d8">The governing ODE is foundational in Stabtragwerk analysis for computing stress distributions and elongation.</data>
  <data key="d9">basis for,foundational to</data>
  <data key="d10">chunk-1dfca5c7dbae86836330061b0f49bc01</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Governing Ordinary Differential Equation (ODE)" target="Statically Determinate Hanging Bar">
  <data key="d7">1.0</data>
  <data key="d8">The governing ODE mathematically describes the physical behavior of a statically determinate hanging bar under self-weight.</data>
