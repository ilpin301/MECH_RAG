<node id="First Principal Stress">
  <data key="d0">First Principal Stress</data>
  <data key="d1">data</data>
  <data key="d2">Denoted as σ1 = τ0, the tensile principal stress located to the right of the origin on the horizontal σ-axis of Mohr's circle in the pure shear stress state</data>
