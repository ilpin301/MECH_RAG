  <data key="d14"></data>
</edge>
<edge source="Second-Order Ordinary Differential Equation" target="Distributed Line Load">
  <data key="d8">1.0</data>
  <data key="d9">The Second-Order Ordinary Differential Equation integrates the Distributed Line Load to model axial equilibrium.</data>
  <data key="d10">incorporates</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
