  <data key="d6"></data>
</node>
<node id="Additive Inverse">
  <data key="d0">Additive Inverse</data>
  <data key="d1">concept</data>
  <data key="d2">The mathematical form taken by each multiplicand in the provided equation, resulting in zero.</data>
