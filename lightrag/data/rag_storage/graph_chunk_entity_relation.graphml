  <data key="d0">Longitudinal Stresses</data>
  <data key="d1">concept</data>
  <data key="d2">Also known as Längsspannungen, a type of stress evaluated in thin-walled cylindrical vessels.</data>
  <data key="d3">chunk-6e3cdc6151a0814d04d2cc632b0969f9</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Circumferential Stresses">
  <data key="d0">Circumferential Stresses</data>
  <data key="d1">concept</data>
  <data key="d2">Also known as Umfangsspannungen, a type of stress evaluated in thin-walled cylindrical vessels.</data>
  <data key="d3">chunk-6e3cdc6151a0814d04d2cc632b0969f9</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
