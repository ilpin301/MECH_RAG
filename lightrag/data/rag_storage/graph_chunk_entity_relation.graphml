  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897131</data>
  <data key="d13"></data>
</edge>
<edge source="Technische Spannung" target="Wahre Spannung">
  <data key="d7">1.0</data>
  <data key="d8">Engineering stress uses the original area while true stress uses the actual deformed area, distinguishing the two stress measures.</data>
  <data key="d9">contrasting_concepts</data>
