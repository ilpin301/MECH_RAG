  <data key="d14"></data>
</edge>
<edge source="Second-Order Ordinary Differential Equation" target="Integration Constant">
  <data key="d8">1.0</data>
  <data key="d9">Solving the Second-Order Ordinary Differential Equation with boundary conditions determines the values of the Integration Constant.</data>
