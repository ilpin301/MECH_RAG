</node>
<node id="1-Axis">
  <data key="d0">1-Axis</data>
  <data key="d1">concept</data>
  <data key="d2">The axis within the principal axis system that is oriented in the direction of the principal stress sigma 1.</data>
  <data key="d3">doc-ba92f82e2b057ed886fb58574a01ea0a-chunk-002</data>
