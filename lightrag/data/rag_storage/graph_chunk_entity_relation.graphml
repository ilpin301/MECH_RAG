  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999870</data>
  <data key="d14"></data>
</edge>
<edge source="Strain" target="Displacement">
  <data key="d8">2.0</data>
  <data key="d9">Displacement is calculated as the integral of strain over the length of the bar&lt;SEP&gt;Strain and displacement are related to each other through the kinematic equation in the bar problem framework.</data>
