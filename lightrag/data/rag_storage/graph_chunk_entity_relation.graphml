  <data key="d14"></data>
</edge>
<edge source="Displacement Gradient Tensor" target="Shear Strains">
  <data key="d8">1.0</data>
  <data key="d9">Shear strains are computed from the displacement gradient tensor.</data>
  <data key="d10">computes</data>
  <data key="d11">chunk-603ebcda3c395baf69674e7e06ddebff</data>
