  <data key="d13">1784904251</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Stress Transformation Framework">
  <data key="d8">1.0</data>
  <data key="d9">The stress transformation framework utilizes the general stress transformation equations to evaluate normal and shear stresses at specific angles.</data>
