  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784964350</data>
  <data key="d6"></data>
</node>
<node id="Zugversuch">
  <data key="d0">Zugversuch</data>
  <data key="d1">method</data>
  <data key="d2">A tensile test in which the equivalent stress equals the principal stress σ1 while σ2 and σ3 equal zero</data>
