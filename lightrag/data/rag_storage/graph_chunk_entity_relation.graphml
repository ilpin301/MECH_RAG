</node>
<node id="Tensors">
  <data key="d0">Tensors</data>
  <data key="d1">concept</data>
  <data key="d2">Mathematical objects in physics that are rotation-independent, meaning their physical statement remains unchanged regardless of the coordinate system.</data>
  <data key="d3">doc-ba92f82e2b057ed886fb58574a01ea0a-chunk-002</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
