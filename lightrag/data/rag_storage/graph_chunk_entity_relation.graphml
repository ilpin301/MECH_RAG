  <data key="d13"></data>
</edge>
<edge source="Boundary Condition U(x=0) = 0" target="Integration Constant C₂">
  <data key="d7">1.0</data>
  <data key="d8">The boundary condition u(x=0) = 0 is used to evaluate the integration constant C₂ as zero.</data>
  <data key="d9">evaluates,yields</data>
  <data key="d10">chunk-cc79c4ab764f023bc17eed0dd0b44b48</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Boundary Condition U'(x=l) = 0" target="Integration Constant C₁">
  <data key="d7">1.0</data>
  <data key="d8">The boundary condition u′(x=l) = 0 is used to evaluate the integration constant C₁ as G.</data>
  <data key="d9">evaluates,yields</data>
  <data key="d10">chunk-cc79c4ab764f023bc17eed0dd0b44b48</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Integration Constant C₂" target="Boundary Conditions">
  <data key="d7">1.0</data>
  <data key="d8">The fixed support boundary condition at x=0 yields the integration constant C₂.</data>
  <data key="d9">yields</data>
  <data key="d10">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
