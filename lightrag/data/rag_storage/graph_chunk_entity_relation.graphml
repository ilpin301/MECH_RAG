<node id="Conjugate Shear Stress Theorem">
  <data key="d0">Conjugate Shear Stress Theorem</data>
  <data key="d1">concept</data>
  <data key="d2">Theorem stating that τ_xy equals τ_yx, ensuring equilibrium of moments</data>
  <data key="d3">chunk-cf5a136f98019f0bd369d2b6d44879f8</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Quadratic Transformation Rule">
