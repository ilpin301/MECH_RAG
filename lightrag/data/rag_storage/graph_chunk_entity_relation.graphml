  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999868</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Stress" target="Shear Stress">
  <data key="d8">1.0</data>
  <data key="d9">In the depicted loading condition, the magnitude of the shear stress is equal to the magnitude of the applied normal stress (τ = σ).</data>
  <data key="d10">magnitude equality</data>
