  <data key="d13">1784904218</data>
  <data key="d14"></data>
</edge>
<edge source="Cauchy Stress Tensor" target="Equation $\Sigma M^{(M)} = 0$">
  <data key="d8">1.0</data>
  <data key="d9">The symmetry of the Cauchy stress tensor is directly derived by evaluating the moment equilibrium equation.</data>
  <data key="d10">derives symmetry from</data>
