  <data key="d5">1784904030</data>
  <data key="d6"></data>
</node>
<node id="Critical Angle φ*">
  <data key="d0">Critical Angle φ*</data>
  <data key="d1">concept</data>
  <data key="d2">The section angle at which extremal normal stresses occur, defined by the condition tan(2φ*) = 2τ_xy/(σ_x - σ_y), yielding two perpendicular principal directions.</data>
  <data key="d3">chunk-0658f7561c12b0a53196517bdee01443</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904030</data>
