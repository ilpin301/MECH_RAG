<edge source="Zugspannung" target="Zugstab">
  <data key="d7">1.0</data>
  <data key="d8">A tension bar experiences positive normal force and tensile stress.</data>
  <data key="d9">experiences</data>
  <data key="d10">doc-424242c0995ba02f22fe1c1864ca5f4b-chunk-000</data>
