</node>
<node id="Elongation Delta L2">
  <data key="d0">Elongation Delta L2</data>
  <data key="d1">concept</data>
  <data key="d2">The vertical displacement or elongation of the middle bar.</data>
  <data key="d3">chunk-cdfa6405eb28772fd593fe970821beaf</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
