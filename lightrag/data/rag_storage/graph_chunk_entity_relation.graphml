</edge>
<edge source="Displacement Gradient Tensor" target="Linearization Process">
  <data key="d8">1.0</data>
  <data key="d9">The linearization process is the foundational step used to derive the displacement gradient tensor.</data>
  <data key="d10">derivation</data>
  <data key="d11">chunk-2e8d2b1a89f6cabb7e72a9e7705515dc</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999724</data>
  <data key="d14"></data>
</edge>
<edge source="Displacement Gradient Tensor" target="Linearization">
  <data key="d8">1.0</data>
  <data key="d9">The linearized first-order approximation of the Taylor series directly yields the displacement gradient tensor.</data>
  <data key="d10">yields</data>
  <data key="d11">chunk-39b2f0f24ccabd94f6101afe155c90b1</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999727</data>
