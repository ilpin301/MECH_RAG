  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999846</data>
  <data key="d14"></data>
</edge>
<edge source="Engineering Shear Strain" target="Principal Strain">
  <data key="d8">1.0</data>
  <data key="d9">Principal Strain equals half the Engineering Shear Strain.</data>
  <data key="d10">equals half of</data>
