</edge>
<edge source="Coefficient Of Thermal Expansion" target="Segment 1">
  <data key="d7">1.0</data>
  <data key="d8">The coefficient of thermal expansion (αT) determines the thermal strain in Segment 1 when temperature change ΔT is applied</data>
  <data key="d9">applies to</data>
  <data key="d10">chunk-9ab72d2dd30449c995d80393a0354227</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897131</data>
  <data key="d13"></data>
</edge>
<edge source="Coefficient Of Thermal Expansion" target="Normal Force Equation">
  <data key="d7">1.0</data>
