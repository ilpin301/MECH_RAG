</node>
<node id="Slip">
  <data key="d0">Slip</data>
  <data key="d1">concept</data>
  <data key="d2">A visible horizontal displacement where the upper portion of a crystal shifts relative to the lower portion, indicating irreversible atomic sliding during plastic deformation.</data>
  <data key="d3">chunk-8fe71d7fb091b493303186868a143418</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999485</data>
