  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897128</data>
  <data key="d13"></data>
</edge>
<edge source="Governing ODE For Axial Displacement" target="One-Dimensional Structural Member">
  <data key="d7">1.0</data>
  <data key="d8">The one-dimensional structural member (rod/bar) is the physical system whose axial displacement is governed by the ODE</data>
