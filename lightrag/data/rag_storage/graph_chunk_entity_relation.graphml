  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897131</data>
  <data key="d13"></data>
</edge>
<edge source="Coefficient Of Thermal Expansion" target="Constitutive Relation">
  <data key="d7">1.0</data>
  <data key="d8">The constitutive relation incorporates the coefficient of thermal expansion α_T to account for thermal strain.</data>
