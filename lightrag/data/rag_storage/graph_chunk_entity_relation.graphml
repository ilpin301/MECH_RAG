</node>
<node id="Stress and Strain Tensors">
  <data key="d0">Stress and Strain Tensors</data>
  <data key="d1">concept</data>
  <data key="d2">Mathematical objects that have a linear homogeneous relationship established by scalar multiplication, division, and a proportionality constant</data>
  <data key="d3">chunk-9d473000f8b85e21224cdb4fbff1c039</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
