<node id="Tau Xi Eta">
  <data key="d0">Tau Xi Eta</data>
  <data key="d1">concept</data>
  <data key="d2">The mathematical notation used to represent shear stresses.</data>
  <data key="d3">chunk-a8be23ae96862171a1f9cb78cb1cfcb0</data>
