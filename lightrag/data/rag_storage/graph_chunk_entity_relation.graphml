  <data key="d1">concept</data>
  <data key="d2">Stress state in 2D continuum mechanics involving normal and shear stress components</data>
  <data key="d3">chunk-792f1aab7b01df3f4ae8fa499208a41a</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
