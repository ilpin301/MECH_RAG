<edge source="Tangent Equation" target="Tangent Subtraction Identity">
  <data key="d8">1.0</data>
  <data key="d9">The Tangent Equation represents the tangent subtraction identity applied to the expression tan(π/4 − γ/2).</data>
  <data key="d10">representation</data>
