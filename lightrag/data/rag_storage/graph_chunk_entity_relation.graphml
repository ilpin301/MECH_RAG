  <data key="d13"></data>
</edge>
<edge source="Differential Segment" target="u">
  <data key="d7">1.0</data>
  <data key="d8">The variable u quantifies how far the left boundary of the green segment has moved to the right.</data>
  <data key="d9">measures displacement of</data>
  <data key="d10">chunk-ba3dc6bb30208edf4354dd20376fa9f6</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Differential Segment" target="u+du">
  <data key="d7">1.0</data>
  <data key="d8">The variable u+du quantifies the total displacement of the right boundary of the green segment.</data>
