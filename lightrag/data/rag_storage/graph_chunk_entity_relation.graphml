  <data key="d13">1784999864</data>
  <data key="d14"></data>
</edge>
<edge source="Shear Strain" target="Plane Stress Compliance Matrix Formulation">
  <data key="d8">1.0</data>
  <data key="d9">The shear strain (γ_xy) is one of the three coupled strain-stress relations in the plane stress compliance matrix formulation.</data>
