  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897132</data>
  <data key="d13"></data>
</edge>
<edge source="Axial Displacement Field" target="Lagrangian Coordinate">
  <data key="d7">1.0</data>
  <data key="d8">The axial displacement field measures the longitudinal displacement with respect to the Lagrangian coordinate.</data>
