  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999869</data>
  <data key="d14"></data>
</edge>
<edge source="Normal Stress" target="Stiffness Form">
  <data key="d8">1.0</data>
  <data key="d9">The stiffness form calculates normal stresses from normal strains using the stiffness coefficient.</data>
  <data key="d10">Calculates,Outputs</data>
