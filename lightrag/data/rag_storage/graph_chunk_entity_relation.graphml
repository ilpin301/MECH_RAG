  <data key="d14"></data>
</edge>
<edge source="Tangent Equation" target="Shear Strain Angle">
  <data key="d8">1.0</data>
  <data key="d9">The Tangent Equation uses the shear strain angle to characterize shear deformation and capture the deformed diagonal's angle.</data>
  <data key="d10">parameter</data>
  <data key="d11">chunk-529957e83da207a93efc376cc085ff93</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
