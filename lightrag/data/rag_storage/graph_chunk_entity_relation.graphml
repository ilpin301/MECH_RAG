  <data key="d14"></data>
</edge>
<edge source="Uniaxial Tensile Test" target="Distortion Energy">
  <data key="d8">1.0</data>
  <data key="d9">The distortion energy in a general state is set equal to the distortion energy found in a uniaxial tensile test.</data>
  <data key="d10">establishes</data>
  <data key="d11">chunk-192ac0f71348510b81fe5091648ee0bb</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d13">1784999883</data>
  <data key="d14"></data>
</edge>
<edge source="Equivalent Stress (σ_v)" target="Yield Stress (σ_y)">
  <data key="d8">1.0</data>
  <data key="d9">At yielding, the Equivalent Stress (σ_v) equals the Yield Stress (σ_y).</data>
  <data key="d10">equal to,yielding</data>
  <data key="d11">chunk-af588c739fd8cf2b760927ad23d5c9f8</data>
