<edge source="Rotational Angle Alpha" target="Shear Strain Gamma Xy">
  <data key="d8">1.0</data>
  <data key="d9">The total shear strain γ_xy is the sum of rotational angles α and β.</data>
  <data key="d10">sum of</data>
  <data key="d11">chunk-c2deea6eaa78cd0a482432f78f4310b0</data>
  <data key="d12">Kapitel12_Verzerrungszustand.pdf</data>
