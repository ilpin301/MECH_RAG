  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
<node id="Page 19">
  <data key="d0">Page 19</data>
  <data key="d1">content</data>
  <data key="d2">A page number element displaying '19', located at the bottom of the page (bbox coordinates [29, 907, 43, 927]) within a German engineering mechanics textbook, serving as a navigational and organizational element.&lt;SEP&gt;A page in the German engineering mechanics textbook containing the problem setup for the three-bar system worked example.</data>
  <data key="d3">chunk-3891c97c9b24173fa3943bf0d59b8fa9&lt;SEP&gt;chunk-59e8bd68bf620257999ef2c55d39d49c</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
