</edge>
<edge source="Thin-Walled Cylindrical Pressure Vessel" target="Longitudinal Stress Equation">
  <data key="d7">1.0</data>
  <data key="d8">The equation represents the force equilibrium in the longitudinal direction of the thin-walled cylindrical pressure vessel under internal pressure.</data>
  <data key="d9">analyzes,equilibrium</data>
