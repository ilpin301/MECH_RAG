  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Length Change Δl">
  <data key="d0">Length Change Δl</data>
  <data key="d1">method</data>
  <data key="d2">A deformation result determined in the hanging bar problem, representing the change in length of the bar.</data>
  <data key="d3">chunk-cc79c4ab764f023bc17eed0dd0b44b48</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
