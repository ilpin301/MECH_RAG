</node>
<node id="Richard von Mises">
  <data key="d0">Richard von Mises</data>
  <data key="d1">person</data>
  <data key="d2">A scientist born in 1883 who published seminal work in 1913, attributed with the Hypothese der Gestaltänderungsenergie (Shape Change Energy Hypothesis) and the von Mises yield criterion.</data>
  <data key="d3">chunk-d00610e182d45a94eb2e712fcaa111a3</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999515</data>
