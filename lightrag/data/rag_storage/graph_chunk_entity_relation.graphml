<edge source="Elastizitätsgesetz" target="Hooke's Law in 3D">
  <data key="d8">1.0</data>
  <data key="d9">Hooke's Law in 3D is identified as the English equivalent or alternative name for Elastizitätsgesetz.</data>
  <data key="d10">alternative name,translation</data>
