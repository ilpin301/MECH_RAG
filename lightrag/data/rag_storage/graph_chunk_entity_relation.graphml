  <data key="d14"></data>
</edge>
<edge source="Material Point P" target="Displacement Field u(x)">
  <data key="d8">1.0</data>
  <data key="d9">The displacement field u(x) is evaluated in the neighborhood surrounding the material point P.</data>
  <data key="d10">describes,evaluated around</data>
