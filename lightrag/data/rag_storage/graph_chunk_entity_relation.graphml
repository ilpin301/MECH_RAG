  <data key="d14"></data>
</edge>
<edge source="Cauchy's Stress Theorem" target="Unit Normal Vector">
  <data key="d8">1.0</data>
  <data key="d9">Cauchy's stress theorem incorporates the unit normal vector n to the cutting surface in the relationship t = σ·n.</data>
  <data key="d10">definition,dependence</data>
  <data key="d11">chunk-7876e6fbf1af5b17253567ec9af4cf91</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904218</data>
  <data key="d14"></data>
</edge>
<edge source="Unit Normal Vector" target="Cutting Surface">
  <data key="d8">1.0</data>
