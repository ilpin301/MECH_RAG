  <data key="d13"></data>
</edge>
<edge source="Governing ODE For Axial Displacement" target="Axial Displacement Field">
  <data key="d7">1.0</data>
  <data key="d8">The governing ODE describes the axial displacement field u(x) of a one-dimensional structural member under distributed axial load</data>
