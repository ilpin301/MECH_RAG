<node id="Mechanical Elongation">
  <data key="d0">Mechanical Elongation</data>
  <data key="d1">concept</data>
  <data key="d2">The component of total elongation derived from Hooke's Law for axial loading, represented mathematically as Nl/(EA)</data>
