  <data key="d9">includes parameter</data>
  <data key="d10">chunk-c38a79e5e8255bb32751c63ad9a1aca1</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897131</data>
  <data key="d13"></data>
</edge>
<edge source="Coefficient Of Thermal Expansion" target="Support Reaction Force Equation">
  <data key="d7">1.0</data>
  <data key="d8">The Support Reaction Force Equation involves the Coefficient Of Thermal Expansion to determine thermal loading.</data>
  <data key="d9">depends on,includes variable</data>
  <data key="d10">chunk-ed4c24e6b357be46b6c720d32cdb5f62</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
