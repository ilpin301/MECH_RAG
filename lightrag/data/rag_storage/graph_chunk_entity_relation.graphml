<edge source="Shear Angle Beta" target="Vertical Line Element">
  <data key="d8">1.0</data>
  <data key="d9">The vertical line element is evaluated alongside the horizontal line element to determine the angular change beta.</data>
  <data key="d10">contributes to,evaluates</data>
  <data key="d11">chunk-7a2dbfa0f426be66876905754d3b98be</data>
