  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Governing Ordinary Differential Equation (ODE)" target="Statically Indeterminate Cases">
  <data key="d7">1.0</data>
  <data key="d8">The mathematical framework provided by the governing ODE is later extended to solve statically indeterminate cases.</data>
  <data key="d9">extended to,framework for</data>
  <data key="d10">chunk-1dfca5c7dbae86836330061b0f49bc01</data>
  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
