  <data key="d6"></data>
</node>
<node id="Force-Related Quantity">
  <data key="d0">Force-Related Quantity</data>
  <data key="d1">concept</data>
  <data key="d2">Also known as Kraftgröße, a classification of physical variables related to forces, such as stress, which complements kinematic quantities.</data>
  <data key="d3">chunk-85da86ad0233986cf40614b65dc61ad2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784897007</data>
