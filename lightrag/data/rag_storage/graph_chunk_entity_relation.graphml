  <data key="d0">Reference Length</data>
  <data key="d1">concept</data>
  <data key="d2">Denoted by l, the original undeformed length of a material body used as the denominator in the engineering strain formula.</data>
  <data key="d3">chunk-85da86ad0233986cf40614b65dc61ad2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
