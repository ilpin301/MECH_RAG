</edge>
<edge source="Axial Displacement Equation" target="Uniformly Hanging Rod">
  <data key="d8">1.0</data>
  <data key="d9">The Axial Displacement Equation provides the analytical solution for the axial displacement at the free end of the Uniformly Hanging Rod.</data>
  <data key="d10">analytical solution</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Axial Displacement Equation" target="Rod Weight">
  <data key="d8">1.0</data>
  <data key="d9">The Axial Displacement Equation uses the Rod Weight to calculate the maximum displacement.</data>
