</node>
<node id="Thermally Loaded Both-Ends-Fixed Bar">
  <data key="d0">Thermally Loaded Both-Ends-Fixed Bar</data>
  <data key="d1">concept</data>
  <data key="d2">A specific type of statically indeterminate structural member subject to thermal loading.</data>
  <data key="d3">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
  <data key="d6"></data>
</node>
<node id="Maximum Displacement u(l)">
  <data key="d0">Maximum Displacement u(l)</data>
  <data key="d1">concept</data>
  <data key="d2">The highest axial displacement of the bar, occurring at the free end with a value of Gl/(2EA).</data>
  <data key="d3">chunk-460d07ec9180c3a338bcc5988e8e42a2</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896993</data>
