  <data key="d11">chunk-b625d3948531b3dcd9b53a158a3a5265</data>
  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904251</data>
  <data key="d14"></data>
</edge>
<edge source="Stress Transformation Equations" target="Shear Stress Transformation Equation">
  <data key="d8">1.0</data>
  <data key="d9">The shear stress transformation equation is one of the three fundamental stress transformation equations.</data>
