  <data key="d6"></data>
</node>
<node id="Axial Elongations">
  <data key="d0">Axial Elongations</data>
  <data key="d1">concept</data>
  <data key="d2">The calculated change in length of the structural bars, denoted by variables like Δl.</data>
  <data key="d3">chunk-6681170cb4ff75b4d310df8342f3aad9</data>
  <data key="d4">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d5">1784896973</data>
