  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904249</data>
  <data key="d14"></data>
</edge>
<edge source="Circumferential Stress" target="Thin-Walled Spherical Pressure Vessel">
  <data key="d8">1.0</data>
  <data key="d9">The thin-walled spherical pressure vessel experiences circumferential stress.</data>
