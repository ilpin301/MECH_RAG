<node id="Thermal Expansion Analysis">
  <data key="d0">Thermal Expansion Analysis</data>
  <data key="d1">method</data>
  <data key="d2">An alternative solution method presented in the document for displacement calculations.&lt;SEP&gt;A method covered in the technical content that is performed without normal force.</data>
