<node id="Three-bar System">
  <data key="d0">Three-bar System</data>
  <data key="d1">artifact</data>
  <data key="d2">A statically indeterminate structural system consisting of three bars connected at a common node K, subjected to an external force F.&lt;SEP&gt;A statically indeterminate structural system consisting of one vertical bar (bar 2) and two inclined bars (bars 1 and 3), also referred to as "einfach statisch unbestimmt gelagertes Stabsystem."</data>
  <data key="d3">chunk-f72457639c5767731980d0c54a4fe069&lt;SEP&gt;chunk-76cd2fb9e592523746e131ec4c914481</data>
