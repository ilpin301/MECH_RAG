</node>
<node id="Force Equilibrium Condition">
  <data key="d0">Force Equilibrium Condition</data>
  <data key="d1">concept</data>
  <data key="d2">The condition equating total tensile force in the wall cross-section (σ_t · 2π · r · t) to the resultant force from internal pressure acting on the projected area (p · π · r²)</data>
  <data key="d3">chunk-493acae899ca4eaaedf536afa97f481b</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903997</data>
