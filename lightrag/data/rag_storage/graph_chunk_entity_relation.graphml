</node>
<node id="Bending Stresses">
  <data key="d0">Bending Stresses</data>
  <data key="d1">concept</data>
  <data key="d2">Stress components in the vessel wall that are neglected under the membrane stress assumption for thin-walled pressure vessels</data>
  <data key="d3">chunk-493acae899ca4eaaedf536afa97f481b</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784903997</data>
