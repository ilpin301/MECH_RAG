</node>
<node id="Equivalent Stress Calculations">
  <data key="d0">Equivalent Stress Calculations</data>
  <data key="d1">method</data>
  <data key="d2">Calculations used in engineering mechanics alongside failure hypotheses.</data>
  <data key="d3">chunk-b562c6cf8ea640066c4829c2dbc8a288</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
