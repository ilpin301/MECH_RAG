  <data key="d0">Material Point Q</data>
  <data key="d1">concept</data>
  <data key="d2">A neighboring material point within a deformable body connected to point P by a directed line element.</data>
  <data key="d3">chunk-646c9364260cc8f0c76b71d04358c907</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784998965</data>
