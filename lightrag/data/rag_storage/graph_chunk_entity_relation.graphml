<node id="Disk">
  <data key="d0">Disk</data>
  <data key="d1">concept</data>
  <data key="d2">A planar structural element whose thickness is small compared to its side lengths, loaded only in its plane with unloaded top and bottom surfaces</data>
  <data key="d3">doc-ba92f82e2b057ed886fb58574a01ea0a-chunk-001</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
