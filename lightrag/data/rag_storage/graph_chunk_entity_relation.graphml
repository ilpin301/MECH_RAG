  <data key="d0">Crystal Lattice</data>
  <data key="d1">concept</data>
  <data key="d2">A microscopic structure shown as a regular 5x6 grid of blue circular nodes representing atoms, connected by blue lines representing interatomic bonds.</data>
  <data key="d3">chunk-8fe71d7fb091b493303186868a143418</data>
  <data key="d4">Kapitel12_Verzerrungszustand.pdf</data>
  <data key="d5">1784999485</data>
