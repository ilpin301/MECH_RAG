<node id="Längsspannungen">
  <data key="d0">Längsspannungen</data>
  <data key="d1">concept</data>
  <data key="d2">Longitudinal stresses (σx) in the wall of a thin-walled cylindrical vessel, derived from force equilibrium in the x-direction.</data>
  <data key="d3">doc-ba92f82e2b057ed886fb58574a01ea0a-chunk-003</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784900562</data>
