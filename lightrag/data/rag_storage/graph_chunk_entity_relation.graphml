  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897128</data>
  <data key="d14"></data>
</edge>
<edge source="Finite Element Formulation" target="Differential Equation dN/dx + n = 0">
  <data key="d8">1.0</data>
  <data key="d9">The differential equilibrium equation establishes the mathematical foundation for the finite element formulation of bar elements.</data>
  <data key="d10">basis of,foundation for</data>
