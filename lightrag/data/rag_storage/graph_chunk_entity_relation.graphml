  <data key="d14"></data>
</edge>
<edge source="Axial Displacement Equation" target="Internal Normal Force">
  <data key="d8">1.0</data>
  <data key="d9">The Axial Displacement Equation at the free end is derived by integrating the linear distribution of the Internal Normal Force.</data>
  <data key="d10">derived from</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
  <data key="d12">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d13">1784897130</data>
  <data key="d14"></data>
</edge>
<edge source="Axial Displacement Equation" target="Statically Determinate Single Rod">
  <data key="d8">1.0</data>
  <data key="d9">The Axial Displacement Equation provides the reference solution for the canonical problem of a Statically Determinate Single Rod.</data>
  <data key="d10">models</data>
  <data key="d11">chunk-051ef03c9d8a42ed1589c14c82007f4e</data>
