  <data key="d12">1784897132</data>
  <data key="d13"></data>
</edge>
<edge source="Distributed Axial Load" target="Self-Weight">
  <data key="d7">1.0</data>
  <data key="d8">The distributed axial load n represents the self-weight of the structure in this specific context.</data>
