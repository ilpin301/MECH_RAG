  <data key="d11">Kapitel10_Elastostatik_Zug_und_Druck_in_Stäben.pdf</data>
  <data key="d12">1784897129</data>
  <data key="d13"></data>
</edge>
<edge source="Axial Displacement Field" target="Longitudinal Strain Field">
  <data key="d7">1.0</data>
  <data key="d8">The longitudinal strain field is defined as the first-order spatial derivative of the axial displacement field.</data>
  <data key="d9">definition,derivative</data>
