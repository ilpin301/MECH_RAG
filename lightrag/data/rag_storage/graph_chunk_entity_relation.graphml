</node>
<node id="Angular Momentum Balance">
  <data key="d0">Angular Momentum Balance</data>
  <data key="d1">concept</data>
  <data key="d2">A principle (Drall- oder Momentengleichgewicht) applied to an infinitesimal volume element, requiring that the resultant moment about any axis through the center of the element vanishes, leading to the symmetric stress tensor.</data>
  <data key="d3">chunk-012508b359d5f14b7a687dd269f97c12</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
  <data key="d6"></data>
</node>
<node id="Cauchy Stress Theory">
  <data key="d0">Cauchy Stress Theory</data>
  <data key="d1">concept</data>
  <data key="d2">A theory in continuum mechanics where the symmetry of the stress tensor is fundamental.</data>
  <data key="d3">chunk-012508b359d5f14b7a687dd269f97c12</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904048</data>
  <data key="d6"></data>
</node>
