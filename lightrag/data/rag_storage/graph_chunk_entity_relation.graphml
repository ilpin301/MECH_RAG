  <data key="d12">Kapitel11_Spannungszustand.pdf</data>
  <data key="d13">1784904180</data>
  <data key="d14"></data>
</edge>
<edge source="Trigonometric Identities" target="Double-Angle Form">
  <data key="d8">1.0</data>
  <data key="d9">Trigonometric identities are used to obtain the double-angle form of the transformation equation</data>
