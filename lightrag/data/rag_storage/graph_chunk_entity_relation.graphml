</node>
<node id="Derivative">
  <data key="d0">Derivative</data>
  <data key="d1">concept</data>
  <data key="d2">The mathematical operation $\frac{d\tau_{\xi\eta}}{d\varphi} = 0$ used to find extremal values of shear stress with respect to the angle $\varphi$.</data>
  <data key="d3">chunk-6b47aa4fc45ad067947c357da574f854</data>
  <data key="d4">Kapitel11_Spannungszustand.pdf</data>
  <data key="d5">1784904052</data>
  <data key="d6"></data>
</node>
