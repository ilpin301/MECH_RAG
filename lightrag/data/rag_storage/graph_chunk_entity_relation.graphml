</edge>
<edge source="Governing ODE For Axial Displacement" target="Displacement Solution">
  <data key="d7">1.0</data>
  <data key="d8">The displacement solution u(x) = (1/EA)(-n/2·x² + G·x) is obtained by integrating the governing ODE</data>
  <data key="d9">derived_from</data>
