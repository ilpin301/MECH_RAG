# --- secrets ---
# .env holds the live Z.ai API key and the LightRAG API key. Never commit it.
.env
!.env.example

# --- upstream LightRAG clone ---
# lightrag/ is a shallow clone of https://github.com/hkuds/lightrag with its own
# git remote. Only the files this project added are tracked; everything else is
# upstream and must be fetched with `git clone`, not vendored.
/lightrag/*
!/lightrag/data/
!/lightrag/.env.example
!/lightrag/INGESTED_SOURCES.txt

# --- run artifacts ---
*.log
/LOG/
/lightrag/ingest_list.txt
__pycache__/
*.pyc
.venv-rag/
/lightrag/.git-upstream-bak/
.obsidian/
.trash/

# RAG base itself is not versioned - it is backed up to Drive via rag_sync.ps1.
# This rule comes AFTER the !/lightrag/data/ whitelist on purpose: that whitelist only
# exists to keep tracked files under data/ reachable, and must never re-admit the store.
/lightrag/data/rag_storage/
